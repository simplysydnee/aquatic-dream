      main { max-width: 880px; margin: 0 auto; padding: 34px 20px 56px; }
      .wrap { max-width: 880px; margin: 0 auto; }
      .eyebrow { margin: 0 0 8px; color: var(--teal); font-size: 13px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
