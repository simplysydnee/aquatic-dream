              "type": "string",
              "pattern": "^\\d{2}:\\d{2}(:\\d{2})?$"
            },
            "end_time": {
              "type": "string",
              "pattern": "^\\d{2}:\\d{2}(:\\d{2})?$"
            },
            "swim_level": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "white",
                    "red",
                    "yellow",
                    "blue",
                    "green"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "instructor_id": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ]
            },
            "location": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 200
