              "type": "string",
              "format": "uuid"
            },
            "capacity": {
              "type": "integer",
              "minimum": 0,
              "maximum": 50
            },
            "day_of_week": {
              "type": "integer",
              "minimum": 0,
              "maximum": 6
            },
